<?xml version="1.0" encoding="utf-8"?>
<!-- R02 识别异常：照片不清晰 / 识别失败两种状态共用一套布局，差异由 ErrorConfig 决定 -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="vm"
            type="com.heban.pestai.recognize.ui.error.ScanErrorViewModel" />
    </data>

    <LinearLayout
        android:id="@+id/errorRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/errorToolbar"
            style="@style/Widget.Pest.Toolbar.Back"
            android:layout_width="match_parent"
            android:layout_height="@dimen/pest_toolbar_height"
            app:title="@string/scan_result_title">

            <ImageButton
                android:id="@+id/errorHistory"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/scan_history"
                android:src="@drawable/ic_history"
                app:onSafeClick="@{() -> vm.openHistory()}"
                app:tint="?attr/colorOnSurfaceVariant" />
        </com.google.android.material.appbar.MaterialToolbar>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp">

                <!-- 照片区：176dp，圆角 16dp，不显示识别框和标签 -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="176dp"
                    android:background="@drawable/scan_bg_photo_16"
                    android:clipToOutline="true">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/errorPhotoStateIcon"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_image"
                            app:tint="?attr/colorOutline" />

                        <TextView
                            android:id="@+id/errorPhotoStateText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/scan_photo_loading"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOutline" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/errorPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/scan_analyzing_photo_desc"
                        android:scaleType="centerCrop" />
                </FrameLayout>

                <!-- 状态区 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <FrameLayout
                        android:id="@+id/errorIconBg"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/pest_bg_circle"
                        app:scanBackgroundTintAttr="@{vm.iconBgAttr}">

                        <ImageView
                            android:id="@+id/errorIcon"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            app:scanIconRes="@{vm.icon}"
                            app:scanTintAttr="@{vm.iconFgAttr}" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/errorTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="@{vm.title}"
                        android:textAppearance="@style/TextAppearance.Pest.TitleLarge.Medium"
                        tools:text="@string/scan_error_blur_title" />

                    <TextView
                        android:id="@+id/errorMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:maxWidth="300dp"
                        android:text="@{vm.message}"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        tools:text="@string/scan_error_blur_message" />
                </LinearLayout>

                <!-- 建议列表 -->
                <LinearLayout
                    android:id="@+id/errorTipsGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{vm.tipsTitle}"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        tools:text="@string/scan_error_blur_tips_title" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/pest_bg_card_12"
                        android:orientation="vertical"
                        app:scanTips="@{vm.tips}" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- 底部按钮栏：左描边、右填充 -->
        <LinearLayout
            android:id="@+id/errorBottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/errorSecondary"
                style="@style/Widget.Pest.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="@{!vm.retrying}"
                android:text="@{vm.secondaryText}"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="18dp"
                app:onSafeClick="@{() -> vm.onSecondaryClick()}"
                app:scanButtonIcon="@{vm.secondaryIcon}"
                app:scanLoading="@{vm.secondaryLoading}"
                app:visible="@{vm.secondaryVisible}"
                tools:text="@string/scan_error_action_recognize_again" />

            <Space
                android:layout_width="12dp"
                android:layout_height="0dp"
                app:visible="@{vm.primaryVisible &amp;&amp; vm.secondaryVisible}" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/errorPrimary"
                style="@style/Widget.Pest.Button.Medium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="@{!vm.retrying}"
                android:text="@{vm.primaryText}"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="18dp"
                app:onSafeClick="@{() -> vm.onPrimaryClick()}"
                app:scanButtonIcon="@{vm.primaryIcon}"
                app:scanLoading="@{vm.primaryLoading}"
                app:visible="@{vm.primaryVisible}"
                tools:text="@string/scan_error_action_retake" />
        </LinearLayout>
    </LinearLayout>
</layout>
