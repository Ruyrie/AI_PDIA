<?xml version="1.0" encoding="utf-8"?>
<!--
    A06 完善资料（第 2 步）：顶栏「完善资料」+ 右侧「跳过」，4dp 进度条（100%），头像、昵称、身份、作物（所在地区已移除）。
    编辑资料模式（M01 我的进入，vm.editMode）：顶栏标题由页面改为「编辑资料」，隐藏「跳过」、进度条与步骤说明，按钮「保存」。
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="vm"
            type="com.heban.pestai.account.ui.profile.ProfileSetupViewModel" />
    </data>

    <LinearLayout
        android:id="@+id/profile_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/profile_toolbar"
            style="@style/Widget.Pest.Toolbar.Back"
            android:layout_width="match_parent"
            android:layout_height="@dimen/pest_toolbar_height"
            app:title="@string/account_profile_title"
            app:titleTextAppearance="@style/TextAppearance.Pest.TitleLarge.Medium">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/profile_skip"
                style="@style/Widget.Pest.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="12dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/account_skip"
                app:onSafeClick="@{() -> vm.skip()}"
                app:visible="@{!vm.editMode}" />
        </com.google.android.material.appbar.MaterialToolbar>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/account_progress_height"
            android:background="?attr/colorPrimary"
            app:visible="@{!vm.editMode}" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:orientation="vertical"
                android:paddingStart="@dimen/pest_form_margin"
                android:paddingTop="16dp"
                android:paddingEnd="@dimen/pest_form_margin"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/account_step_2_of_2"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorPrimary"
                    app:visible="@{!vm.editMode}" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/account_profile_desc"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    app:visible="@{!vm.editMode}" />

                <!-- 头像：96dp 圆形，primaryContainer 底显示昵称首字；右下角 36dp 相机角标；上传中显示进度圈；
                     点击弹出「拍照 / 从相册选择 / 取消」 -->
                <FrameLayout
                    android:id="@+id/profile_avatar_container"
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="24dp"
                    android:contentDescription="@string/account_avatar_desc"
                    android:focusable="true">

                    <com.heban.pestai.base.widget.AvatarView
                        android:id="@+id/profile_avatar"
                        android:layout_width="@dimen/account_avatar_size"
                        android:layout_height="@dimen/account_avatar_size"
                        android:layout_gravity="center"
                        android:backgroundTint="?attr/colorPrimaryContainer"
                        android:importantForAccessibility="no"
                        app:avatarImage="@{vm.avatarImage}"
                        app:avatarName="@{vm.nickname}"
                        app:avatarTextSize="40sp" />

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        app:indicatorColor="?attr/colorPrimary"
                        app:indicatorSize="40dp"
                        app:trackThickness="4dp"
                        app:visible="@{vm.avatarUploading}" />

                    <FrameLayout
                        android:layout_width="@dimen/account_avatar_badge"
                        android:layout_height="@dimen/account_avatar_badge"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/account_bg_avatar_badge"
                        android:importantForAccessibility="no">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_photo_camera"
                            app:tint="?attr/colorOnPrimary" />
                    </FrameLayout>
                </FrameLayout>

                <!-- 昵称：右侧计数 4/16 -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Account.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:hint="@string/account_nickname"
                    app:counterEnabled="true"
                    app:counterMaxLength="16">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="text"
                        android:maxLength="16"
                        android:maxLines="1"
                        android:text="@={vm.nickname}" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 种植身份：三段分段按钮 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/account_identity"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/profile_identity_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/profile_identity_farmer"
                        style="@style/Widget.Account.SegmentButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/profile_identity_gardener"
                        style="@style/Widget.Account.SegmentButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/profile_identity_technician"
                        style="@style/Widget.Account.SegmentButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- 主要作物：10 个筛选 Chip，流式换行，间距 8dp -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    app:accountCropTitle="@{vm.cropTitle}" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/profile_crop_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="8dp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp">

                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.Pest.Button"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/pest_button_height_form"
                        android:enabled="@{vm.canSave}"
                        android:onClick="@{() -> vm.save()}"
                        app:accountProfileEdit="@{vm.editMode}"
                        app:accountProfileSaving="@{vm.saving}" />

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:elevation="8dp"
                        android:indeterminate="true"
                        app:indicatorColor="?attr/colorOnSurfaceVariant"
                        app:indicatorSize="24dp"
                        app:trackThickness="3dp"
                        app:visible="@{vm.saving}" />
                </FrameLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</layout>
