<?xml version="1.0" encoding="utf-8"?>
<!--
    A10 更换手机号：编辑态（顶栏、当前手机号与说明、新手机号、验证码、确认更换）与成功态（与 A08 成功态一致，整页居中）。
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="vm"
            type="com.heban.pestai.account.ui.phone.ChangePhoneViewModel" />
    </data>

    <FrameLayout
        android:id="@+id/change_phone_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface">

        <!-- 编辑态 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            app:visible="@{!vm.done}">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/change_phone_toolbar"
                style="@style/Widget.Pest.Toolbar.Back"
                android:layout_width="match_parent"
                android:layout_height="@dimen/pest_toolbar_height"
                app:title="@string/account_change_phone_title"
                app:titleTextAppearance="@style/TextAppearance.Pest.TitleLarge.Medium" />

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/pest_form_margin"
                    android:paddingTop="16dp"
                    android:paddingEnd="@dimen/pest_form_margin"
                    android:paddingBottom="24dp">

                    <!-- 当前手机号 + 说明 -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/account_current_phone"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/change_phone_current"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@{vm.currentMasked}"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        tools:text="138****5678" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/account_change_phone_desc"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <!-- 新手机号：+86 前缀、3-4-4 分隔；格式错误 / 与当前号相同 / 已注册提示在下方 -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/change_phone_new_layout"
                        style="@style/Widget.Account.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:hint="@string/account_new_phone"
                        app:accountHelper="@{vm.newPhoneError}"
                        app:accountHelperError="@{true}"
                        app:placeholderText="@string/account_new_phone_placeholder"
                        app:prefixText="@string/account_phone_prefix">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789 "
                            android:imeOptions="actionNext"
                            android:inputType="phone"
                            android:maxLength="13"
                            android:text="@={vm.newPhone}" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- 验证码：右侧「获取验证码」/「{N}s 后重发」，下方已发送提示或验证码错误 -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/change_phone_code_layout"
                        style="@style/Widget.Account.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/account_field_gap"
                        android:hint="@string/account_code"
                        app:accountCodeActionEnabled="@{vm.canSendCode}"
                        app:accountHelper="@{vm.codeHint}"
                        app:accountHelperError="@{vm.codeHintError}"
                        app:placeholderText="@string/account_code_placeholder"
                        app:suffixText="@{vm.countdownText}">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/change_phone_code_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="number"
                            android:maxLength="6"
                            android:text="@={vm.code}" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp">

                        <com.google.android.material.button.MaterialButton
                            style="@style/Widget.Pest.Button"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/pest_button_height_form"
                            android:enabled="@{vm.canSubmit}"
                            android:onClick="@{() -> vm.submit()}"
                            android:text="@{vm.loading ? `` : @string/account_change_phone_submit}" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:elevation="8dp"
                            android:indeterminate="true"
                            app:indicatorColor="?attr/colorOnSurfaceVariant"
                            app:indicatorSize="24dp"
                            app:trackThickness="3dp"
                            app:visible="@{vm.loading}" />
                    </FrameLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>

        <!-- 成功态：顶栏隐藏，整页居中（与 A08 一致） -->
        <LinearLayout
            android:id="@+id/change_phone_success"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/pest_form_margin"
            android:paddingEnd="@dimen/pest_form_margin"
            android:paddingBottom="24dp"
            app:visible="@{vm.done}"
            tools:visibility="gone">

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/pest_bg_circle"
                android:backgroundTint="?attr/colorPrimaryContainer">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_check_circle"
                    app:tint="?attr/colorOnPrimaryContainer" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/account_change_phone_success_title"
                android:textAppearance="?attr/textAppearanceHeadlineMedium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:maxWidth="320dp"
                android:text="@{vm.successDesc}"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="今后请使用 139****1111 登录" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.4" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/change_phone_done"
                style="@style/Widget.Pest.Button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/pest_button_height_form"
                android:text="@string/account_done"
                app:onSafeClick="@{() -> vm.finishPage()}" />
        </LinearLayout>
    </FrameLayout>
</layout>
