<?xml version="1.0" encoding="utf-8"?>
<!--
    A02 引导页：顶部栏（64dp，右侧「跳过」）、ViewPager2 三屏、页码指示点、底部按钮区（左右 24dp、底部 40dp）。
    指示点与按钮放在 ViewPager2 外部的固定区域，不参与滑动。
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="vm"
            type="com.heban.pestai.account.ui.onboarding.OnboardingViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/onboarding_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:clipChildren="false">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/onboarding_skip"
            style="@style/Widget.Pest.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:minWidth="0dp"
            android:minHeight="40dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/account_skip"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:onSafeClick="@{() -> vm.onSkip()}" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/onboarding_pager"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/pest_toolbar_height"
            android:layout_marginBottom="40dp"
            android:clipChildren="false"
            app:layout_constraintBottom_toTopOf="@id/onboarding_indicators"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/onboarding_indicators"
            android:layout_width="wrap_content"
            android:layout_height="8dp"
            android:layout_marginTop="@dimen/pest_toolbar_height"
            android:gravity="center_vertical"
            android:importantForAccessibility="no"
            android:orientation="horizontal"
            app:layout_constraintBottom_toTopOf="@id/onboarding_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.85">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                app:indicatorSelected="@{vm.currentPage == 0}" />

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="8dp"
                app:indicatorSelected="@{vm.currentPage == 1}" />

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="8dp"
                app:indicatorSelected="@{vm.currentPage == 2}" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/onboarding_primary"
            style="@style/Widget.Pest.Button"
            android:layout_width="0dp"
            android:layout_height="@dimen/pest_button_height_form"
            android:layout_marginStart="@dimen/pest_form_margin"
            android:layout_marginEnd="@dimen/pest_form_margin"
            android:layout_marginBottom="12dp"
            android:text="@{vm.isLast ? @string/account_start_use : @string/account_next}"
            app:layout_constraintBottom_toTopOf="@id/onboarding_login"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:onClick="@{() -> vm.onPrimaryClick()}" />

        <LinearLayout
            android:id="@+id/onboarding_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="26dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:minHeight="@dimen/pest_touch_target"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:onSafeClick="@{() -> vm.onLogin()}">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/account_has_account"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/account_login"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorPrimary" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
