<?xml version="1.0" encoding="utf-8"?>
<!-- A08 设置新密码：编辑态（顶栏、步骤条、新密码 + 强度、确认新密码、规则卡、完成）与成功态（整页居中） -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="vm"
            type="com.heban.pestai.account.ui.reset.ResetPwdViewModel" />
    </data>

    <FrameLayout
        android:id="@+id/reset_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface">

        <!-- 编辑态 -->
        <LinearLayout
            android:id="@+id/reset_form"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            app:visible="@{!vm.done}">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/reset_toolbar"
                style="@style/Widget.Pest.Toolbar.Back"
                android:layout_width="match_parent"
                android:layout_height="@dimen/pest_toolbar_height"
                app:title="@string/account_reset_title"
                app:titleTextAppearance="@style/TextAppearance.Pest.TitleLarge.Medium" />

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/pest_form_margin"
                    android:paddingTop="16dp"
                    android:paddingEnd="@dimen/pest_form_margin"
                    android:paddingBottom="24dp">

                    <com.heban.pestai.account.ui.common.AccountStepBar
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:accountStep="2"
                        app:accountStepFirst="@string/account_step_verify_phone"
                        app:accountStepSecond="@string/account_step_set_password" />

                    <!-- 新密码：眼睛按钮切换明文 -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/reset_password_layout"
                        style="@style/Widget.Account.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:hint="@string/account_new_password"
                        app:accountEyeOpen="@{vm.passwordVisible}"
                        app:accountHelper="@{vm.passwordError}"
                        app:accountHelperError="@{true}"
                        app:endIconContentDescription="@string/account_toggle_password_desc"
                        app:endIconDrawable="@drawable/ic_visibility"
                        app:endIconMode="custom">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="textPassword"
                            android:maxLength="20"
                            android:text="@={vm.password}"
                            app:accountPasswordVisible="@{vm.passwordVisible}" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- 三段强度条 + 「强度：强」（与 A09 共用） -->
                    <include
                        layout="@layout/view_account_password_strength"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:level="@{vm.strengthLevel}" />

                    <!-- 确认新密码：一致时右侧 check_circle，下方「两次输入一致」 -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Account.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="@string/account_confirm_new_password"
                        app:accountHelper="@{vm.confirmHint}"
                        app:accountHelperError="@{vm.confirmHintError}"
                        app:endIconDrawable="@drawable/ic_check_circle_fill"
                        app:endIconMode="custom"
                        app:endIconTint="?attr/colorPrimary"
                        app:endIconVisible="@{vm.confirmMatched}"
                        app:helperTextTextColor="?attr/colorPrimary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="textPassword"
                            android:maxLength="20"
                            android:text="@={vm.confirm}"
                            app:accountPasswordVisible="@{vm.passwordVisible}" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- 规则卡：surfaceContainerLow 底，圆角 12dp，内边距 14×16dp（与 A09 共用） -->
                    <include
                        layout="@layout/view_account_password_rules"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        app:lengthState="@{vm.ruleLength ? 1 : 0}"
                        app:mixState="@{vm.ruleMix ? 1 : 0}"
                        app:recentState="@{vm.ruleRecent}"
                        app:showRecent="@{true}" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp">

                        <com.google.android.material.button.MaterialButton
                            style="@style/Widget.Pest.Button"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/pest_button_height_form"
                            android:enabled="@{vm.canSubmit}"
                            android:onClick="@{() -> vm.submit()}"
                            android:text="@{vm.loading ? `` : @string/account_done}" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:elevation="8dp"
                            android:indeterminate="true"
                            app:indicatorColor="?attr/colorOnSurfaceVariant"
                            app:indicatorSize="24dp"
                            app:trackThickness="3dp"
                            app:visible="@{vm.loading}" />
                    </FrameLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>

        <!-- 成功态：顶栏隐藏，整页居中 -->
        <LinearLayout
            android:id="@+id/reset_success"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/pest_form_margin"
            android:paddingEnd="@dimen/pest_form_margin"
            android:paddingBottom="24dp"
            app:visible="@{vm.done}">

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/pest_bg_circle"
                android:backgroundTint="?attr/colorPrimaryContainer">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_lock_reset"
                    app:tint="?attr/colorOnPrimaryContainer" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/account_reset_success_title"
                android:textAppearance="?attr/textAppearanceHeadlineMedium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:maxWidth="320dp"
                android:text="@string/account_reset_success_desc"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.4" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reset_go_login"
                style="@style/Widget.Pest.Button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/pest_button_height_form"
                android:text="@string/account_go_login"
                app:onSafeClick="@{() -> vm.goLogin()}" />
        </LinearLayout>
    </FrameLayout>
</layout>
