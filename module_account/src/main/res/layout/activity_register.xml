<?xml version="1.0" encoding="utf-8"?>
<!-- A05 注册（第 1 步）：顶栏「注册账号」+ 4dp 进度条（50%）+ 表单 -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="vm"
            type="com.heban.pestai.account.ui.register.RegisterViewModel" />
    </data>

    <LinearLayout
        android:id="@+id/register_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/register_toolbar"
            style="@style/Widget.Pest.Toolbar.Back"
            android:layout_width="match_parent"
            android:layout_height="@dimen/pest_toolbar_height"
            app:title="@string/account_register_title"
            app:titleTextAppearance="@style/TextAppearance.Pest.TitleLarge.Medium" />

        <!-- 进度条：secondaryContainer 底，primary 填充 50% -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/account_progress_height"
            android:background="?attr/colorSecondaryContainer"
            android:orientation="horizontal"
            android:weightSum="2">

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/colorPrimary" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:orientation="vertical"
                android:paddingStart="@dimen/pest_form_margin"
                android:paddingTop="16dp"
                android:paddingEnd="@dimen/pest_form_margin"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/account_step_1_of_2"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/account_register_desc"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <!-- 手机号 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/register_phone_layout"
                    style="@style/Widget.Account.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/account_field_gap"
                    android:hint="@string/account_phone"
                    app:accountHelper="@{vm.phoneError}"
                    app:accountHelperError="@{true}"
                    app:prefixText="@string/account_phone_prefix">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:digits="0123456789 "
                        android:imeOptions="actionNext"
                        android:inputType="phone"
                        android:maxLength="13"
                        android:text="@={vm.phone}" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 验证码 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/register_code_layout"
                    style="@style/Widget.Account.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/account_field_gap"
                    android:hint="@string/account_code"
                    app:accountCodeActionEnabled="@{vm.canSendCode}"
                    app:accountHelper="@{vm.sentHint}"
                    app:placeholderText="@string/account_code_placeholder"
                    app:suffixText="@{vm.countdownText}">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/register_code_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        android:maxLength="6"
                        android:text="@={vm.code}" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 设置密码 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/register_password_layout"
                    style="@style/Widget.Account.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/account_field_gap"
                    android:hint="@string/account_set_password"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="textPassword"
                        android:maxLength="20"
                        android:text="@={vm.password}" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 密码强度：三段强度条 + 「强度：弱 / 中 / 强」 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:contentDescription="@string/account_strength_bar_desc"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="@dimen/account_strength_height"
                        android:layout_weight="1"
                        android:background="@drawable/account_bg_strength_segment"
                        app:accountSegmentIndex="@{0}"
                        app:accountStrengthLevel="@{vm.strengthLevel}" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="@dimen/account_strength_height"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/account_bg_strength_segment"
                        app:accountSegmentIndex="@{1}"
                        app:accountStrengthLevel="@{vm.strengthLevel}" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="@dimen/account_strength_height"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/account_bg_strength_segment"
                        app:accountSegmentIndex="@{2}"
                        app:accountStrengthLevel="@{vm.strengthLevel}" />

                    <TextView
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:gravity="end"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        app:accountStrengthText="@{vm.strengthLevel}" />
                </LinearLayout>

                <!-- 规则：8–20 位 / 包含字母 / 包含数字 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        app:accountRuleMet="@{vm.ruleLength}" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/account_rule_length"
                        android:textAppearance="@style/TextAppearance.Account.Rule"
                        app:accountRuleTextMet="@{vm.ruleLength}" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="16dp"
                        android:importantForAccessibility="no"
                        app:accountRuleMet="@{vm.ruleLetter}" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/account_rule_letter"
                        android:textAppearance="@style/TextAppearance.Account.Rule"
                        app:accountRuleTextMet="@{vm.ruleLetter}" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="16dp"
                        android:importantForAccessibility="no"
                        app:accountRuleMet="@{vm.ruleDigit}" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/account_rule_digit"
                        android:textAppearance="@style/TextAppearance.Account.Rule"
                        app:accountRuleTextMet="@{vm.ruleDigit}" />
                </LinearLayout>

                <!-- 确认密码：两次一致时右侧显示 check_circle 实心图标 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/register_confirm_layout"
                    style="@style/Widget.Account.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="@string/account_confirm_password"
                    app:accountHelper="@{vm.confirmError}"
                    app:accountHelperError="@{true}"
                    app:endIconDrawable="@drawable/ic_check_circle_fill"
                    app:endIconMode="custom"
                    app:endIconTint="?attr/colorPrimary"
                    app:endIconVisible="@{vm.confirmMatched}">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:maxLength="20"
                        android:text="@={vm.confirm}" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 协议行 -->
                <LinearLayout
                    android:id="@+id/register_agreement_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-15dp"
                        android:checked="@={vm.agreed}"
                        android:contentDescription="@string/account_agreement_prefix" />

                    <TextView
                        android:id="@+id/register_agreement_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="33dp"
                    android:text="@string/account_agreement_required"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorError"
                    app:visible="@{vm.agreementHint}" />

                <!-- 下一步 -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">

                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.Pest.Button"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/pest_button_height_form"
                        android:enabled="@{vm.canNext}"
                        android:onClick="@{() -> vm.next()}"
                        android:text="@{vm.loading ? `` : @string/account_next}" />

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:elevation="8dp"
                        android:indeterminate="true"
                        app:indicatorColor="?attr/colorOnSurfaceVariant"
                        app:indicatorSize="24dp"
                        app:trackThickness="3dp"
                        app:visible="@{vm.loading}" />
                </FrameLayout>

                <!-- 已有账号？去登录 -->
                <LinearLayout
                    android:id="@+id/register_go_login"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:minHeight="@dimen/pest_touch_target"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/account_has_account"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/account_go_login"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorPrimary" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</layout>
