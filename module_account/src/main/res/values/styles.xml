<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A06 种植身份分段按钮：高 40dp，两端圆角 20dp，选中 secondaryContainer + check 图标 -->
    <style name="Widget.Account.SegmentButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:checkable">true</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Pest.Full</item>
        <item name="backgroundTint">@color/account_segment_background</item>
        <item name="android:textColor">@color/account_segment_text</item>
        <item name="iconTint">@color/account_segment_text</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">8dp</item>
        <item name="iconGravity">textStart</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/account_segment_ripple</item>
        <item name="android:textAppearance">@style/TextAppearance.Pest.LabelLarge</item>
    </style>

    <!-- 表单页 Outlined 输入框（标签始终浮在边框上，便于显示 +86 前缀与占位文字） -->
    <style name="Widget.Account.TextInputLayout" parent="Widget.Pest.TextInputLayout">
        <item name="expandedHintEnabled">false</item>
        <item name="prefixTextColor">?attr/colorOnSurface</item>
        <item name="prefixTextAppearance">@style/TextAppearance.Pest.BodyLarge</item>
        <item name="suffixTextAppearance">@style/TextAppearance.Pest.LabelLarge</item>
        <item name="placeholderTextAppearance">@style/TextAppearance.Pest.BodyLarge</item>
        <item name="placeholderTextColor">?attr/colorOutline</item>
        <item name="errorIconDrawable">@null</item>
    </style>

    <style name="Widget.Account.TextInputLayout.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">4dp</item>
        <item name="boxCornerRadiusTopEnd">4dp</item>
        <item name="boxCornerRadiusBottomStart">4dp</item>
        <item name="boxCornerRadiusBottomEnd">4dp</item>
        <item name="boxStrokeColor">?attr/colorPrimary</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
    </style>

    <!-- 引导页浮动标签：40dp 胶囊，surface 底，level3 阴影 -->
    <style name="Widget.Account.FloatChip" parent="">
        <item name="android:layout_height">@dimen/account_float_chip_height</item>
        <item name="android:background">@drawable/account_bg_float_chip</item>
        <item name="android:elevation">6dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <!-- 规则提示行：12sp -->
    <style name="TextAppearance.Account.Rule" parent="TextAppearance.Pest.BodySmall" />
</resources>
