<?xml version="1.0" encoding="utf-8"?>
<!-- 语音模式的「按住 说话」按钮（40dp 高，圆角 20dp，与胶囊 26dp 圆角同心）：
     底色 ai_talk_container（surfaceContainerHighest；上滑到取消区时为 errorContainer），
     上面叠一层按下状态层 ai_talk_state（按住时加深） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ai_talk_container" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ai_talk_state" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
