<?xml version="1.0" encoding="utf-8"?>
<!--
    Q03 历史对话（module_ai 内部页面）。顶栏 64dp（返回 + 标题）→
    列表区：居中进度（LOADING）/ 下拉刷新 + 分组列表（SUCCESS）/ 空状态（EMPTY）/ 加载失败（ERROR）。
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="com.heban.pestai.base.UiState" />

        <variable
            name="vm"
            type="com.heban.pestai.ai.history.ChatHistoryViewModel" />
    </data>

    <LinearLayout
        android:id="@+id/history_chat_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/history_chat_toolbar"
            style="@style/Widget.Pest.Toolbar.Back"
            android:layout_width="match_parent"
            android:layout_height="@dimen/pest_toolbar_height"
            app:contentInsetStartWithNavigation="0dp"
            app:title="@string/ai_history_title"
            app:titleMarginStart="0dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/history_chat_refresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:enabled="@{vm.uiState == UiState.SUCCESS}"
                app:refreshing="@{safeUnbox(vm.refreshing)}"
                app:visible="@{vm.uiState == UiState.SUCCESS}">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/history_chat_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="@dimen/pest_page_margin"
                    android:paddingEnd="@dimen/pest_page_margin"
                    android:paddingBottom="24dp"
                    android:scrollbarStyle="outsideOverlay"
                    android:scrollbars="vertical" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/history_chat_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:contentDescription="@string/pest_loading"
                android:indeterminate="true"
                app:indicatorColor="?attr/colorPrimary"
                app:visible="@{vm.uiState == UiState.LOADING}" />

            <!-- 空状态：120dp 圆形 surfaceContainerHigh 底 + forum 56dp -->
            <LinearLayout
                android:id="@+id/history_chat_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="40dp"
                android:paddingEnd="40dp"
                android:paddingBottom="120dp"
                app:visible="@{vm.uiState == UiState.EMPTY}">

                <FrameLayout
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="@drawable/pest_bg_circle"
                    android:backgroundTint="?attr/colorSurfaceContainerHigh">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_forum"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/ai_history_empty_title"
                    android:textAppearance="@style/TextAppearance.Pest.TitleLarge.Medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/ai_history_empty_desc"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/history_chat_start"
                    style="@style/Widget.Pest.Button.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="24dp"
                    android:paddingEnd="24dp"
                    android:text="@string/ai_history_start"
                    app:icon="@drawable/ic_auto_awesome"
                    app:iconPadding="8dp"
                    app:iconSize="18dp" />
            </LinearLayout>

            <!-- 加载失败：原因 + 重试 -->
            <LinearLayout
                android:id="@+id/history_chat_error"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="40dp"
                android:paddingEnd="40dp"
                android:paddingBottom="120dp"
                app:visible="@{vm.uiState == UiState.ERROR}">

                <FrameLayout
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="@drawable/pest_bg_circle"
                    android:backgroundTint="?attr/colorErrorContainer">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_cloud_off"
                        app:tint="?attr/colorOnErrorContainer" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/pest_load_failed"
                    android:textAppearance="@style/TextAppearance.Pest.TitleLarge.Medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@{vm.errorText}"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/history_chat_retry"
                    style="@style/Widget.Pest.Button.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="24dp"
                    android:paddingEnd="24dp"
                    android:text="@string/pest_retry"
                    app:icon="@drawable/ic_refresh"
                    app:iconPadding="8dp"
                    app:iconSize="18dp"
                    app:onSafeClick="@{() -> vm.reload()}" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</layout>
