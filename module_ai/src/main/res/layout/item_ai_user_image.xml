<?xml version="1.0" encoding="utf-8"?>
<!-- Q02 用户图片消息：一条消息的全部图片为一项，右对齐，左侧至少留白 48dp，排在文字气泡之前。
     1 张 180 × 135dp（圆角 16dp）；2–4 张 2 列 96dp 方格；5–9 张 3 列 80dp 方格（圆角 12dp，间距 4dp）。
     加载前显示 surfaceContainerHighest 底；点按某一张全屏预览 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="48dp">

    <com.heban.pestai.ai.chat.ImageGridView
        android:id="@+id/ai_image_grid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end" />
</FrameLayout>
