<?xml version="1.0" encoding="utf-8"?>
<!-- Q03 底部提示：加载下一页时 16dp 圆形进度 +「正在加载…」；加载失败时 refresh 图标 +「加载失败，点按重试」（点按重试） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ai_session_footer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center"
    android:minHeight="40dp"
    android:orientation="horizontal">

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/ai_session_footer_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:indicatorColor="?attr/colorPrimary"
        app:indicatorSize="16dp"
        app:trackThickness="2dp" />

    <ImageView
        android:id="@+id/ai_session_footer_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_refresh"
        app:tint="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/ai_session_footer_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textAppearance="?attr/textAppearanceBodySmall" />
</LinearLayout>
