<?xml version="1.0" encoding="utf-8"?>
<!-- Q01 AI 问答 · 新对话（MainActivity 第 2 个 Tab；状态栏间距与软键盘由 MainActivity 统一处理）。
     只有三部分：顶部栏（标题 + 历史对话）、居中的欢迎语、底部输入栏（待发送图片 + 胶囊）及其下方的一行提示 -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="vm"
            type="com.heban.pestai.ai.AskAiViewModel" />
    </data>

    <LinearLayout
        android:id="@+id/ask_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <!-- 顶部栏 64dp：标题 / 历史对话 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/pest_toolbar_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:maxLines="1"
                android:text="@string/ai_title"
                android:textAppearance="?attr/textAppearanceTitleLarge" />

            <!-- 历史对话（Q03）；游客弹「登录后才能使用」 -->
            <ImageButton
                android:id="@+id/ask_history"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ai_history"
                android:src="@drawable/ic_history"
                app:onSafeClick="@{() -> vm.onHistoryClick()}"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- 顶部栏与输入栏之间的空白区：欢迎语在其中居中（键盘弹出时区域变矮，随之重新居中）；
             区域放不下时由 AskAiFragment 隐藏欢迎语，不与输入栏重叠 -->
        <FrameLayout
            android:id="@+id/ask_welcome_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/ask_welcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/ai_bg_welcome_icon">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_auto_awesome_fill"
                        app:tint="?attr/colorOnPrimaryContainer" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/ai_welcome_title"
                    android:textAppearance="?attr/textAppearanceTitleLarge" />
            </LinearLayout>
        </FrameLayout>

        <!-- 输入栏：待发送图片缩略图条 + 胶囊（相机 / 输入框或「按住 说话」/ 麦克风或键盘 /「+」/ 发送），见 view_ai_composer 与 ComposerBar -->
        <include
            android:id="@+id/ask_composer"
            layout="@layout/view_ai_composer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:composer="@{vm}"
            app:defaultHint="@{@string/ai_input_hint}" />

        <TextView
            android:id="@+id/ask_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/ai_model_notice"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</layout>
