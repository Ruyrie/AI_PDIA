<?xml version="1.0" encoding="utf-8"?>
<!-- Q02 AI 问答 · 追问识别结果 / 对话页 / 历史对话。根布局用 InsetsHelper 避开状态栏、导航栏与软键盘 -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="com.heban.pestai.base.UiState" />

        <variable
            name="vm"
            type="com.heban.pestai.ai.chat.ChatViewModel" />
    </data>

    <LinearLayout
        android:id="@+id/chat_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <!-- 顶部栏 64dp：返回 / 居中两行标题 / 新对话 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/pest_toolbar_height"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageButton
                android:id="@+id/chat_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/pest_back"
                android:src="@drawable/ic_arrow_back"
                app:tint="?attr/colorOnSurface" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/ai_title"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_disclaimer"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/chat_new"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ai_new_chat"
                android:src="@drawable/ic_add_comment"
                app:tint="?attr/colorOnSurfaceVariant" />
        </FrameLayout>

        <!-- 列表区：对话列表 / 历史对话加载中 / 加载失败 /「回到底部」按钮 -->
        <FrameLayout
            android:id="@+id/chat_list_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- 高度随内容（最多占满列表区）并贴底：消息较少时上方留白、内容从底部开始；
                 内容超过一屏后正常从上往下排列，正在输出的气泡向下增长，由 ChatActivity 平滑跟随滚动 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chat_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:scrollbars="none" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/chat_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:contentDescription="@string/pest_loading"
                android:indeterminate="true"
                app:indicatorColor="?attr/colorPrimary"
                app:visible="@{vm.loadState == UiState.LOADING}" />

            <!-- 打开历史对话失败：加载失败 + 原因 + 重试 -->
            <LinearLayout
                android:id="@+id/chat_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="40dp"
                android:paddingEnd="40dp"
                app:visible="@{vm.loadState == UiState.ERROR}">

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="@drawable/pest_bg_circle"
                    android:backgroundTint="?attr/colorSurfaceContainerHigh"
                    android:importantForAccessibility="no"
                    android:padding="32dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_cloud_off"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/pest_load_failed"
                    android:textAppearance="@style/TextAppearance.Pest.TitleLarge.Medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@{vm.loadError}"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chat_retry"
                    style="@style/Widget.Pest.Button.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/pest_retry"
                    app:onSafeClick="@{() -> vm.retryLoad()}" />
            </LinearLayout>

            <!-- 回到底部：不在底部时显示在输入栏上方右侧，40dp 圆形，surfaceContainerHigh 底，level2 阴影 -->
            <ImageButton
                android:id="@+id/chat_scroll_bottom"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/ai_bg_scroll_bottom"
                android:contentDescription="@string/ai_scroll_bottom"
                android:elevation="3dp"
                android:src="@drawable/ai_ic_arrow_downward"
                android:stateListAnimator="@null"
                android:visibility="gone"
                app:tint="?attr/colorOnSurfaceVariant" />
        </FrameLayout>

        <!-- 输入栏（与 Q01 共用）：待发送图片缩略图条 + 胶囊（相机 / 输入框或「按住 说话」/ 麦克风或键盘 /「+」/ 发送，生成中为停止），
             见 view_ai_composer 与 ComposerBar -->
        <include
            android:id="@+id/chat_composer"
            layout="@layout/view_ai_composer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:composer="@{vm}"
            app:defaultHint="@{@string/ai_chat_input_hint}" />
    </LinearLayout>
</layout>
