<?xml version="1.0" encoding="utf-8"?>
<!-- M02 设置 -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="vm"
            type="com.heban.pestai.mine.ui.settings.SettingsViewModel" />
    </data>

    <LinearLayout
        android:id="@+id/settings_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/settings_toolbar"
            style="@style/Widget.Pest.Toolbar.Back"
            android:layout_width="match_parent"
            android:layout_height="@dimen/pest_toolbar_height"
            app:title="@string/mine_settings_title" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/pest_page_margin"
                android:paddingEnd="@dimen/pest_page_margin"
                android:paddingBottom="24dp">

                <!-- ========== 账号 ========== -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp"
                    android:text="@string/mine_settings_group_account"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorPrimary" />

                <!-- 手机号 → A10 更换手机号（游客不可点击、无箭头；点击由 SettingsActivity 按登录状态设置） -->
                <LinearLayout
                    android:id="@+id/settings_row_phone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@{vm.guest ? @drawable/mine_bg_item_single : @drawable/mine_bg_item_first}"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/pest_list_item_two_line"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp"
                    tools:background="@drawable/mine_bg_item_first">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/pest_bg_circle"
                        android:backgroundTint="?attr/colorPrimaryContainer"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:src="@drawable/ic_smartphone"
                        app:tint="?attr/colorOnPrimaryContainer" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mine_settings_phone"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />

                        <TextView
                            android:id="@+id/settings_tv_phone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@{vm.phoneText}"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            tools:text="138****5678 · 用于登录和找回密码" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant"
                        app:visible="@{!vm.guest}" />
                </LinearLayout>

                <!-- 修改密码 → A07（游客隐藏） -->
                <LinearLayout
                    android:id="@+id/settings_row_change_pwd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pest_group_gap"
                    android:background="@drawable/mine_bg_item_middle"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/pest_list_item_two_line"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp"
                    app:onSafeClick="@{() -> vm.onChangePasswordClick()}"
                    app:visible="@{!vm.guest}">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/pest_bg_circle"
                        android:backgroundTint="?attr/colorPrimaryContainer"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:src="@drawable/ic_password"
                        app:tint="?attr/colorOnPrimaryContainer" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mine_settings_change_pwd"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mine_settings_change_pwd_desc"
                            android:textAppearance="?attr/textAppearanceBodyMedium" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <!-- 账号恢复码 → A12（游客隐藏）：副标题为状态（onResume 刷新），未生成时标题右侧 error 色小圆点 -->
                <LinearLayout
                    android:id="@+id/settings_row_recovery_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pest_group_gap"
                    android:background="@drawable/mine_bg_item_middle"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/pest_list_item_two_line"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp"
                    app:onSafeClick="@{() -> vm.onRecoveryCodeClick()}"
                    app:visible="@{!vm.guest}">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/pest_bg_circle"
                        android:backgroundTint="?attr/colorPrimaryContainer"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:src="@drawable/mine_ic_key"
                        app:tint="?attr/colorOnPrimaryContainer" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/mine_settings_recovery_code"
                                android:textAppearance="?attr/textAppearanceBodyLarge" />

                            <View
                                android:id="@+id/settings_recovery_code_dot"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/pest_bg_circle"
                                android:backgroundTint="?attr/colorError"
                                android:contentDescription="@string/mine_settings_recovery_code_missing"
                                app:visible="@{vm.recoveryCodeMissing}" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/settings_tv_recovery_code"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@{vm.recoveryCodeText}"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            tools:text="未生成 · 手机号停用又忘记密码时用于找回账号" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <!-- 注销账号 → A11（游客隐藏）：图标 error 色 -->
                <LinearLayout
                    android:id="@+id/settings_row_deactivate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pest_group_gap"
                    android:background="@drawable/mine_bg_item_last"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/pest_list_item_two_line"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp"
                    app:onSafeClick="@{() -> vm.onDeactivateClick()}"
                    app:visible="@{!vm.guest}">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/pest_bg_circle"
                        android:backgroundTint="?attr/colorErrorContainer"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:src="@drawable/mine_ic_person_remove"
                        app:tint="?attr/colorError" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mine_settings_deactivate"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mine_settings_deactivate_desc"
                            android:textAppearance="?attr/textAppearanceBodyMedium" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <!-- ========== 识别与问答 ========== -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp"
                    android:text="@string/mine_settings_group_recognize"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorPrimary" />

                <!-- 识别照片保存到相册：整行点击切换开关；点在开关上由开关自身消费 -->
                <LinearLayout
                    android:id="@+id/settings_row_album"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/mine_bg_item_first"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/pest_list_item_two_line"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/pest_bg_circle"
                        android:backgroundTint="?attr/colorSecondaryContainer"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:src="@drawable/ic_photo_library"
                        app:tint="?attr/colorOnSecondaryContainer" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mine_settings_save_album"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mine_settings_save_album_desc"
                            android:textAppearance="?attr/textAppearanceBodyMedium" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/settings_switch_album"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:checked="@={vm.saveToAlbum}"
                        android:contentDescription="@string/mine_settings_save_album" />
                </LinearLayout>

                <!-- 清理图片缓存：只有「清理」可点；清理中显示 16dp 小圆形进度 -->
                <LinearLayout
                    android:id="@+id/settings_row_cache"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pest_group_gap"
                    android:background="@drawable/mine_bg_item_last"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/pest_list_item_two_line"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/pest_bg_circle"
                        android:backgroundTint="?attr/colorTertiaryContainer"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:src="@drawable/ic_cleaning_services"
                        app:tint="?attr/colorOnTertiaryContainer" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mine_settings_clear_cache"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />

                        <TextView
                            android:id="@+id/settings_tv_cache_size"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@{vm.cacheSizeText}"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            tools:text="128 MB · 图片框架磁盘缓存" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:minWidth="64dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/settings_btn_clear"
                            style="@style/Widget.Pest.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:enabled="@{vm.canClear}"
                            android:minWidth="0dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@string/mine_settings_clear"
                            android:textColor="@color/mine_text_primary"
                            app:invisible="@{vm.clearing}"
                            app:onSafeClick="@{() -> vm.clearCache()}" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/settings_progress_clear"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:indeterminate="true"
                            app:indicatorSize="16dp"
                            app:trackThickness="2dp"
                            app:visible="@{vm.clearing}" />
                    </FrameLayout>
                </LinearLayout>

                <!-- ========== 关于 ========== -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp"
                    android:text="@string/mine_settings_group_about"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorPrimary" />

                <LinearLayout
                    android:id="@+id/settings_row_about"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/mine_bg_item_single"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/pest_list_item_two_line"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp"
                    app:onSafeClick="@{() -> vm.onAboutClick()}">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/pest_bg_circle"
                        android:backgroundTint="?attr/colorSurfaceContainerHighest"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:src="@drawable/ic_info"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mine_settings_about_app"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@{vm.versionText}"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            tools:text="版本 1.0.0 · 用户协议 · 隐私政策" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <!-- ========== 底部按钮 ========== -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settings_btn_switch_account"
                    style="@style/Widget.Pest.Button.Medium"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/pest_button_height"
                    android:layout_marginTop="24dp"
                    android:text="@{vm.guest ? @string/mine_login_register : @string/mine_settings_switch_account}"
                    android:textColor="?attr/colorOnSurface"
                    app:backgroundTint="?attr/colorSurfaceContainer"
                    app:onSafeClick="@{() -> vm.onSwitchAccountClick()}"
                    app:rippleColor="?attr/colorControlHighlight"
                    tools:text="@string/mine_settings_switch_account" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settings_btn_logout"
                    style="@style/Widget.Pest.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/pest_button_height"
                    android:layout_marginTop="8dp"
                    android:text="@string/mine_settings_logout"
                    android:textColor="@color/mine_text_error"
                    app:onSafeClick="@{() -> vm.onLogoutClick()}"
                    app:visible="@{!vm.guest}" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</layout>
