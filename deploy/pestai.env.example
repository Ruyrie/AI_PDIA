# =====================================================================
# /etc/pestai/pestai.env：pestai-server 在云服务器上的专用配置（systemd EnvironmentFile）
#
# deploy/install.sh 首次安装时以本模板生成（root 所有，权限 600），空着的密码 / 密钥自动随机生成；
# 之后重新部署会保留这里修改过的值，只有传入 --public-url 时更新 PESTAI_PUBLIC_BASE_URL。
# 修改后执行：systemctl restart pestai（改了 DB_PASSWORD 或 SERVER_PORT 请重新运行部署，以同步 MySQL 账号与 Nginx）
#
# 这里的值是真正的系统环境变量，优先于 /opt/pestai/.env（从本机 server\.env 上传的大模型 / 短信密钥）中的同名值。
# 格式：每行 KEY=值，不要写 export；值中有空格时用双引号括起来。
# =====================================================================

# 后端只监听本机，外网经 Nginx（80 端口）转发
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# 数据库：本机 MySQL 的 pestai 库与 pestai 账号（install.sh 创建，只能从本机连接）；密码首次安装时随机生成
DB_URL=jdbc:mysql://localhost:3306/pestai?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=pestai
DB_PASSWORD=

# 登录令牌签名密钥：首次安装时随机生成（服务器专用）；修改后所有用户需要重新登录
JWT_SECRET=

# 后台管理（http://公网IP/admin/）初始管理员 admin 的密码：首次安装时随机生成，显示在部署结果中；
# 只在后端第一次启动、还没有管理员时使用，首次登录后必须修改（之后改这里不会影响已有的管理员密码）
PESTAI_ADMIN_INITIAL_PASSWORD=

# 后台保存的 API Key / AccessKey 的加密主密钥：首次安装时随机生成；不要修改，否则后台保存的密钥无法解密、需要重新填写
PESTAI_CONFIG_SECRET=

# App 访问服务器的地址（http://公网IP，末尾不要加 /），由 --public-url 写入。
# 图片地址 = 该地址 + /files/ + 相对路径，必须与 App 中使用的服务器地址一致，否则图片显示不出来
PESTAI_PUBLIC_BASE_URL=

# 上传图片的保存目录
PESTAI_FILE_ROOT=/data/pestai/files

# JVM 参数：适合 2 核 4G 的服务器；内存只有 2G 时可改为 -Xms128m -Xmx512m
JAVA_OPTS="-Xms256m -Xmx768m -Duser.timezone=Asia/Shanghai -Dfile.encoding=UTF-8"
