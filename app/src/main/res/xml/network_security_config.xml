<?xml version="1.0" encoding="utf-8"?>
<!--
    允许以 HTTP（明文）访问服务器，调试版与正式版相同：
    本机开发时模拟器通过 http://10.0.2.2:8080 访问电脑上的后端；部署到云服务器后只有公网 IP、没有域名，
    无法申请 HTTPS 证书，App 通过 http://公网IP 访问（服务器地址也可在「我的 → 关于」中修改为任意 IP）。
    正式上线应使用备案域名 + HTTPS，届时把 cleartextTrafficPermitted 改回 false。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
