# 复制为 server/.env 后填写（.env 已被 .gitignore 忽略，不要提交）。也可以直接设置同名系统环境变量。
# Spring Boot 按 ISO-8859-1 读取本文件，中文必须写成 \uXXXX 转义（如签名「恒创联众」写成 \u6052\u521b\u8054\u4f17）。

# 数据库
DB_USERNAME=root
DB_PASSWORD=

# 登录令牌签名密钥（至少 32 字节的随机字符串），可用下面的命令生成：
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# 大模型：通义千问（北京地域，识图 qwen3.8-max、语音识别 qwen3-asr-flash）、DeepSeek（问答 deepseek-flash）；留空时使用 Mock
# 这些 Key 与模型名也可以在后台管理（/admin/ → 系统配置）中填写，后台的值优先，修改后立即生效
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
# 语音识别模型（App 语音输入，与识图共用 DASHSCOPE_API_KEY），默认 qwen3-asr-flash
ASR_MODEL=qwen3-asr-flash

# 模型自动备用：AI 问答 DeepSeek 失败时改用通义千问（用 DASHSCOPE_API_KEY），拍照识别通义千问失败时改用 DeepSeek（用 DEEPSEEK_API_KEY）；
# App 不提示，后台记录所用模型。true / false，默认 true；也可在后台「系统配置 → 自动备用」中修改
AI_FALLBACK_ENABLED=true
CHAT_FALLBACK_MODEL=qwen3.8-max
VISION_FALLBACK_MODEL=deepseek-flash

# 后台管理（/admin/）：首次启动时创建管理员 admin 的初始密码；留空时随机生成并在启动日志中打印一次，首次登录后必须修改
PESTAI_ADMIN_INITIAL_PASSWORD=
# 后台保存的 API Key / AccessKey 的加密主密钥（随机字符串，设置后不要再改）；留空时由 JWT_SECRET 派生
PESTAI_CONFIG_SECRET=

# 阿里云号码认证服务 · 短信认证（赠送签名 + 赠送模板）；AccessKey 或签名留空时验证码只打印到服务器日志
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=100001
ALIYUN_SMS_TEMPLATE_RESET=100003
ALIYUN_SMS_TEMPLATE_REBIND=100004
ALIYUN_SMS_TEMPLATE_CHANGE_PHONE=100002
ALIYUN_SMS_TEMPLATE_VERIFY=100005
