# 复制为 server/.env 后填写（.env 已被 .gitignore 忽略，不要提交）。也可以直接设置同名系统环境变量。
# Spring Boot 按 ISO-8859-1 读取本文件，中文必须写成 \uXXXX 转义（如签名「恒创联众」写成 \u6052\u521b\u8054\u4f17）。

# 数据库
DB_USERNAME=root
DB_PASSWORD=

# 登录令牌签名密钥（至少 32 字节的随机字符串），可用下面的命令生成：
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# 大模型：通义千问（北京地域，识图 qwen3.8-max）、DeepSeek（问答 deepseek-flash）；留空时使用 Mock
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=

# 阿里云号码认证服务 · 短信认证（赠送签名 + 赠送模板）；AccessKey 或签名留空时验证码只打印到服务器日志
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=100001
ALIYUN_SMS_TEMPLATE_RESET=100003
ALIYUN_SMS_TEMPLATE_REBIND=100004
ALIYUN_SMS_TEMPLATE_CHANGE_PHONE=100002
ALIYUN_SMS_TEMPLATE_VERIFY=100005
